rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Non-member may only append their own uid to memberIds (invite join).
    function isJoiningHousehold() {
      return signedIn()
        && resource.data.inviteCode is string
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'memberProfiles'])
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    function householdData(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    // Safe role lookup: never error on missing maps/keys (errors deny the request).
    function memberRole(householdId) {
      let data = householdData(householdId);
      return data.get('createdBy', '') == request.auth.uid
        ? 'owner'
        : data.get('memberProfiles', {}).get(request.auth.uid, {}).get('role', 'editor');
    }

    function isPlanEditor(householdId) {
      return isMember(householdId) && memberRole(householdId) != 'viewer';
    }

    function sameHouseholdUser(userId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId
            == get(/databases/$(database)/documents/users/$(userId)).data.householdId;
    }

    match /users/{userId} {
      allow read: if signedIn() && (
        request.auth.uid == userId
        || sameHouseholdUser(userId)
      );
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    function isHouseholdOwner() {
      return signedIn() && (
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid)
        || (
          (!('createdBy' in resource.data) || resource.data.createdBy == null)
          && resource.data.memberIds.size() == 1
          && request.auth.uid in resource.data.memberIds
        )
      );
    }

    // Invite lookup by code (members always; others can read to join via inviteCode query)
    match /households/{householdId} {
      allow get: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || resource.data.inviteCode is string
      );
      // Join queries inviteCode with limit(1). Rules cannot inspect where() values.
      allow list: if signedIn() && request.query.limit <= 1;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.currency == 'ILS';
      allow update: if isMember(householdId) || isJoiningHousehold();
      allow delete: if isHouseholdOwner();

      match /categories/{docId} {
        allow read: if isMember(householdId);
        allow write: if isPlanEditor(householdId);
      }
      match /subcategories/{docId} {
        allow read: if isMember(householdId);
        allow write: if isPlanEditor(householdId);
      }
      match /recurringBills/{docId} {
        allow read: if isMember(householdId);
        allow write: if isPlanEditor(householdId);
      }

      match /months/{monthId} {
        allow read: if isMember(householdId);
        allow write: if isPlanEditor(householdId);

        match /incomeSources/{docId} {
          allow read: if isMember(householdId);
          allow write: if isPlanEditor(householdId);
        }
        match /incomeEntries/{docId} {
          allow read, write: if isMember(householdId);
        }
        match /plans/{docId} {
          allow read: if isMember(householdId);
          allow write: if isPlanEditor(householdId);
        }
        match /expenses/{docId} {
          allow read, write: if isMember(householdId);
        }
        // Legacy per-month catalog (kept for one-shot migration).
        match /categories/{docId} {
          allow read, write: if isMember(householdId);
        }
        match /lineItems/{docId} {
          allow read, write: if isMember(householdId);
        }
      }
    }
  }
}
