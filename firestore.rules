rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn()
        && exists(/databases/$(database)/documents/households/$(householdId))
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    // Non-member may only append their own uid to memberIds (invite join).
    function isJoiningHousehold() {
      return signedIn()
        && resource.data.inviteCode is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
        && request.auth.uid in request.resource.data.memberIds
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    function isHouseholdOwner() {
      return signedIn() && (
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid)
        || (
          (!('createdBy' in resource.data) || resource.data.createdBy == null)
          && resource.data.memberIds.size() == 1
          && request.auth.uid in resource.data.memberIds
        )
      );
    }

    // Invite lookup by code (members always; others can read to join via inviteCode query)
    match /households/{householdId} {
      allow get: if signedIn() && (
        request.auth.uid in resource.data.memberIds
        || resource.data.inviteCode is string
      );
      // Join queries inviteCode with limit(1). Rules cannot inspect where() values.
      allow list: if signedIn() && request.query.limit <= 1;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.currency == 'ILS';
      allow update: if isMember(householdId) || isJoiningHousehold();
      allow delete: if isHouseholdOwner();

      match /categories/{docId} {
        allow read, write: if isMember(householdId);
      }
      match /subcategories/{docId} {
        allow read, write: if isMember(householdId);
      }

      match /months/{monthId} {
        allow read, write: if isMember(householdId);

        match /incomeSources/{docId} {
          allow read, write: if isMember(householdId);
        }
        match /incomeEntries/{docId} {
          allow read, write: if isMember(householdId);
        }
        match /plans/{docId} {
          allow read, write: if isMember(householdId);
        }
        match /expenses/{docId} {
          allow read, write: if isMember(householdId);
        }
        // Legacy per-month catalog (kept for one-shot migration).
        match /categories/{docId} {
          allow read, write: if isMember(householdId);
        }
        match /lineItems/{docId} {
          allow read, write: if isMember(householdId);
        }
      }
    }
  }
}
