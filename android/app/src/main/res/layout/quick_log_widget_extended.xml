<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_log_widget_background"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textColor="#1C2A24"
        android:includeFontPadding="false"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="September 2026" />

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="start"
        android:textAlignment="viewStart"
        android:textColor="#5A6B63"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="Sign in to log"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/widget_hero_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="start"
        android:includeFontPadding="false"
        android:textAlignment="viewStart"
        android:textColor="#5A6B63"
        android:textSize="10sp"
        tools:text="Remaining" />

    <TextView
        android:id="@+id/widget_hero_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:includeFontPadding="false"
        android:textColor="#3D7A5F"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:text="₪1,240.00" />

    <LinearLayout
        android:id="@+id/widget_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/quick_log_widget_stat_bg"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_income_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#5A6B63"
                    android:textSize="10sp"
                    tools:text="Income" />

                <TextView
                    android:id="@+id/widget_income_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#1C2A24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="₪8,000.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/quick_log_widget_stat_bg"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_spent_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#5A6B63"
                    android:textSize="10sp"
                    tools:text="Spent" />

                <TextView
                    android:id="@+id/widget_spent_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#1C2A24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="₪5,200.00" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/quick_log_widget_stat_bg"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_saved_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#5A6B63"
                    android:textSize="10sp"
                    tools:text="Saved" />

                <TextView
                    android:id="@+id/widget_saved_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#1C2A24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="₪800.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/quick_log_widget_stat_bg"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/widget_budget_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#5A6B63"
                    android:textSize="10sp"
                    tools:text="Budget" />

                <TextView
                    android:id="@+id/widget_budget_amount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:maxLines="1"
                    android:textAlignment="viewStart"
                    android:includeFontPadding="false"
                    android:textColor="#1C2A24"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="₪7,500.00" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/widget_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:background="@drawable/quick_log_widget_button"
        android:gravity="center"
        android:includeFontPadding="false"
        android:minHeight="32dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Log spend" />
</LinearLayout>
